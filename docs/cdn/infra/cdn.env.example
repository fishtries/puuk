# Nonsecret template. Actual file: /etc/puuk/cdn.env, root:root 0600.
# Fill secrets through protected operator tooling, never commit their values.
# Existing JWT_SECRET stays unchanged in its current environment source.
CDN_DELIVERY_ENABLED=false
CDN_ORIGIN_ENABLED=false
CDN_PURGE_ENABLED=false
CDN_BASE_URL=https://media.puuk.fun
CDN_TICKET_TTL_SECONDS=1800
CDN_DELIVERY_EPOCH=cdn-pilot-v1
CDN_PILOT_USER_IDS=
CDN_RESOURCE_ID=
CDN_SIGNING_SECRET=
CDN_ORIGIN_SECRET=
CDN_PURGE_TOKEN=
DELIVERY_LOCK_DIR=/home/fish/apps/puuk/puuk/brain/.delivery-locks
