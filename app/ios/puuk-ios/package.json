{
  "name": "puuk-ios",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "postinstall": "node scripts/patch-expo-audio.js && node scripts/patch-react-native-menu.js && node scripts/patch-expo-symbols.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-.*|@react-navigation/.*|react-native-.*)/.*)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/slider": "5.2.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-network": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "http-proxy": "^1.18.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-easing-gradient": "^1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "babel-preset-expo": "~58.0.20",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0"
  }
}
